{
  "opencollection": "1.0.0",
  "info": {
    "name": "Checkly Public Accounts Dashboards API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Dashboards",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Dashboards",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.checklyhq.com/v1/dashboards",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit the number of results"
              }
            ]
          },
          "docs": "Retrieve all public dashboards"
        }
      ]
    }
  ],
  "bundled": true
}