{
  "opencollection": "1.0.0",
  "info": {
    "name": "Checkly Public Accounts Locations API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Locations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Locations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.checklyhq.com/v1/locations"
          },
          "docs": "Retrieve all available monitoring locations"
        }
      ]
    }
  ],
  "bundled": true
}